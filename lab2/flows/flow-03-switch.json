        "id": "2a6865aff0d1cddf",
        "type": "function",
        "z": "b23bc93cefc3edda",
        "name": "function 2",
        "func": "let input = msg.payload;\nlet resultArray = [];\n\n// Жесткая проверка: это должно быть число, и оно должно быть больше 0\nif (typeof input === 'number' && input > 0) {\n    \n    for (let i = 1; i <= input; i++) {\n        resultArray.push(i * 10); // умножаем на 10\n    }\n    \n    msg.payload = {\n        original: input,\n        status: \"ok\",\n        array: resultArray\n    };\n} else {\n    // Если это не число, мы не запускаем цикл, а выдаем ошибку\n    msg.payload = {\n        status: \"error\",\n        message: \"Ожидалось положительное число\"\n    };\n}\nreturn msg;",
