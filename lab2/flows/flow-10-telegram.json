        "z": "ccbe2fd1f5aaff23",
        "name": "function 6",
        "func": "// Получаем текст сообщения от пользователя\nlet text = msg.payload.content;\nlet chatId = msg.payload.chatId;\nlet responseText = \"\";\n\n// Проверяем команды\nif (text === '/start') {\n    responseText = \"Привет! Я бот для лабораторной работы №2. Напиши /lab2, чтобы узнать подробности.\";\n} else if (text === '/lab2') {\n    responseText = \"Этот бот создан в рамках изучения Node-RED. Я умею отвечать на команды и повторять текст (эхо).\";\n} else {\n    // Эхо-ответ\n    responseText = \"Вы написали: \" + text;\n}\n\n// Формируем сообщение для отправки обратно в Telegram\nmsg.payload = {\n    chatId: chatId,\n    type: \"message\",\n    content: responseText\n};\n\nreturn msg;",
