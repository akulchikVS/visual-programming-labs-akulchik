        "z": "462a8cbdc9ea5592",
        "name": "function 4",
        "func": "// Получаем параметр id из URL\nlet id = msg.req.params.id;\nlet numId = parseInt(id);\n\n// Проверяем на ошибки\nif (numId === 0) {\n    msg.statusCode = 400; // Bad Request\n    msg.payload = { \"error\": \"ID не может быть равен 0\" };\n} else if (numId > 100) {\n    msg.statusCode = 404; // Not Found\n    msg.payload = { \"error\": \"Элемент с таким ID не найден\" };\n} else {\n    msg.statusCode = 200; // OK\n    msg.payload = {\n        \"id\": numId,\n        \"name\": \"Элемент \" + numId,\n        \"message\": \"Успешно найдено\"\n    };\n}\nreturn msg;",
